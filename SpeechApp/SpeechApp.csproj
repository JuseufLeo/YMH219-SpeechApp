<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>SpeechApp</RootNamespace>
    <!-- Vosk'un yerel (native) kütüphanesi 64 bit olduğu için -->
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <!-- Metinden sese: Windows'un yerleşik konuşma sentezleyicisi -->
    <PackageReference Include="System.Speech" Version="9.0.0" />
    <!-- Sesten metne: çevrimdışı konuşma tanıma (Türkçe model ile) -->
    <PackageReference Include="Vosk" Version="0.3.38" />
    <!-- Mikrofondan ses almak için -->
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Konuşma tanıma modeli derleme çıktısına kopyalanır -->
    <None Include="Models\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
